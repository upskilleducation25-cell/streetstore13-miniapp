{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_ADMIN_CHAT_ID",
    "TELEGRAM_API_BASE_URL",
    "MINIAPP_URL",
    "CORS_ORIGINS",
    "PORT",
    "TRUST_PROXY",
    "ADMIN_SESSION_TTL_HOURS",
    "ADMIN_COOKIE_SECURE",
    "ADMIN_COOKIE_SAMESITE",
    "STORAGE_DRIVER",
    "LOCAL_STORAGE_DIR",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET",
    "R2_PUBLIC_URL",
    "R2_ENDPOINT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@ss13/miniapp#test": {
      "dependsOn": ["build"]
    }
  }
}
