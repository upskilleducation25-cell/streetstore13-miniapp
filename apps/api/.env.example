NODE_ENV=development
PORT=3000

# PostgreSQL (infra/docker-compose.yml)
DATABASE_URL=postgresql://ss13:ss13@localhost:5432/streetstore13?schema=public

# Redis (черги сповіщень; поки не використовується, див. docs/architecture.md)
REDIS_URL=redis://localhost:6379

# Telegram-бот від @BotFather. Реальний токен — тільки в локальному .env, ніколи в git.
TELEGRAM_BOT_TOKEN=
# Чат власника / менеджерів для сповіщень про нові замовлення: числовий ID чату
# (для групи — від'ємний, напр. -1001234567890) або @username каналу. Бот має бути
# доданий у цей чат. Якщо порожньо — береться settings.notifications.adminChatId з БД.
TELEGRAM_ADMIN_CHAT_ID=
# Публічна HTTPS-адреса Mini App: кнопка «Відкрити замовлення» в повідомленні покупцю.
# Порожньо — повідомлення без кнопки.
MINIAPP_URL=
# Скільки секунд initData вважається свіжим (24 години)
TELEGRAM_INIT_DATA_TTL_SECONDS=86400

# Секрет підпису JWT покупця (мінімум 32 символи). Згенерувати: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-dev-only-change-me-0000
JWT_EXPIRES_IN_SECONDS=604800

# Дозволені адреси фронтендів (через кому)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
