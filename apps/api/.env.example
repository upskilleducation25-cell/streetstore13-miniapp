NODE_ENV=development
PORT=3000

# PostgreSQL (infra/docker-compose.yml)
DATABASE_URL=postgresql://ss13:ss13@localhost:5432/streetstore13?schema=public

# Redis (черги сповіщень; поки не використовується, див. docs/architecture.md)
REDIS_URL=redis://localhost:6379

# Telegram-бот від @BotFather. Реальний токен — тільки в локальному .env, ніколи в git.
TELEGRAM_BOT_TOKEN=
# Чат власника / менеджерів для сповіщень про нові замовлення: числовий ID чату
# (для групи — від'ємний, напр. -1001234567890) або @username каналу. Бот має бути
# доданий у цей чат. Якщо порожньо — береться settings.notifications.adminChatId з БД.
TELEGRAM_ADMIN_CHAT_ID=
# Публічна HTTPS-адреса Mini App: кнопка «Відкрити замовлення» в повідомленні покупцю.
# Порожньо — повідомлення без кнопки.
MINIAPP_URL=
# Скільки секунд initData вважається свіжим (24 години)
TELEGRAM_INIT_DATA_TTL_SECONDS=86400

# Секрет підпису JWT покупця (мінімум 32 символи). Згенерувати: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-dev-only-change-me-0000
JWT_EXPIRES_IN_SECONDS=604800

# Дозволені адреси фронтендів (через кому)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Express trust proxy за реверс-проксі (Railway, nginx): кількість проксі, напр. 1.
# Потрібно, щоб ліміт спроб входу в адмінку бачив реальний IP. Локально — порожньо.
TRUST_PROXY=

# ─── Адмінка ───
# Перший власник: ADMIN_OWNER_EMAIL=… ADMIN_OWNER_PASSWORD=… pnpm admin:create-owner
# (ці дві змінні потрібні лише на час команди, не зберігайте пароль у .env).
# Сесія адміна, годин
ADMIN_SESSION_TTL_HOURS=12
# Cookie тільки через HTTPS. Порожньо = true у production, false локально.
ADMIN_COOKIE_SECURE=
# strict — адмінка й API на одному домені (admin.x.ua + api.x.ua). none — різні сайти
# (тоді ADMIN_COOKIE_SECURE=true). CSRF-токен перевіряється завжди.
ADMIN_COOKIE_SAMESITE=strict

# ─── Фото товарів ───
# r2 — Cloudflare R2; local — тека на диску API (тільки розробка); none — завантаження вимкнено.
# Порожньо = local локально, none у production.
STORAGE_DRIVER=
LOCAL_STORAGE_DIR=uploads
# Cloudflare R2 (S3 API). Ключі — тільки на сервері, у браузер не потрапляють.
# Токен R2 з правами Object Read & Write лише на цей бакет.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Публічна адреса бакета: власний домен (рекомендовано) або https://pub-….r2.dev
R2_PUBLIC_URL=
